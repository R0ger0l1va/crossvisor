{
  "name": "@crossvisor/db",
  "version": "0.0.0",
  "private": true,
  "description": "Esquema de PostgreSQL (Drizzle ORM), migraciones y utilidades de BD",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@crossvisor/contracts": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@crossvisor/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "^6.0.2"
  }
}
