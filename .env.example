# Copia este archivo a .env (en la raíz) y ajusta los valores.

# --- Base de datos (app + cola de trabajos) ---
DATABASE_URL=postgres://crossvisor:crossvisor@localhost:5432/crossvisor

# --- Cifrado de credenciales de XCP-ng / Proxmox guardadas en la BD ---
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=

# --- API (apps/api) ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Worker (apps/worker) ---
# Carpeta temporal para discos cuando no se puede hacer streaming directo.
WORKER_SCRATCH_DIR=/var/tmp/crossvisor
WORKER_CONCURRENCY=1

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
